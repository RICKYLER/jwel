rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function signedInEmail() {
      return isSignedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function emailMatches(value) {
      return signedInEmail() != ''
        && value is string
        && signedInEmail() == value.lower();
    }

    function tokenRole() {
      return isSignedIn() && request.auth.token.role is string
        ? request.auth.token.role.lower()
        : 'guest';
    }

    function legacyUserRole() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role is string
          ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.lower()
          : 'guest';
    }

    function signedInRole() {
      return tokenRole() != 'guest'
        ? tokenRole()
        : signedInEmail() != ''
          && exists(/databases/$(database)/documents/authorizedSuperadmin/$(signedInEmail()))
            ? 'superadmin'
            : signedInEmail() != ''
              && exists(/databases/$(database)/documents/authorizedAdmin/$(signedInEmail()))
                ? 'admin'
                : signedInEmail() != ''
                  && exists(/databases/$(database)/documents/authorizedPersonnel/$(signedInEmail()))
                    ? 'staff'
                    : legacyUserRole();
    }

    function isPersonnelRoleValue(value) {
      return value is string
        && (
          value.lower() == 'staff'
          || value.lower() == 'mechanics personnel'
          || value.lower() == 'inventory personnel'
          || value.lower() == 'cashier personnel'
          || value.lower() == 'front desk personnel'
        );
    }

    function requestedPersonnelRole() {
      return request.resource.data.role is string
        ? request.resource.data.role.lower()
        : request.resource.data.personnelRole is string
          ? request.resource.data.personnelRole.lower()
          : 'staff';
    }

    function existingPersonnelRole() {
      return resource.data.role is string
        ? resource.data.role.lower()
        : resource.data.personnelRole is string
          ? resource.data.personnelRole.lower()
          : 'staff';
    }

    function isStaffOrHigher() {
      return signedInRole() == 'staff'
        || signedInRole() == 'mechanics personnel'
        || signedInRole() == 'inventory personnel'
        || signedInRole() == 'cashier personnel'
        || signedInRole() == 'front desk personnel'
        || signedInRole() == 'admin'
        || signedInRole() == 'superadmin';
    }

    function isAdminOrHigher() {
      return signedInRole() == 'admin' || signedInRole() == 'superadmin';
    }

    function isSuperadmin() {
      return signedInRole() == 'superadmin';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdminOrHigher());
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdminOrHigher());
      allow delete: if isSuperadmin();
    }

    match /authorizedSuperadmin/{docId} {
      allow read: if isSuperadmin()
        || emailMatches(docId)
        || emailMatches(resource.data.email)
        || emailMatches(resource.data.emailAddress)
        || emailMatches(resource.data.authorizedEmail)
        || emailMatches(resource.data.userEmail);
      allow create, update, delete: if isSuperadmin();
    }

    match /authorizedAdmin/{docId} {
      allow read: if isAdminOrHigher()
        || emailMatches(docId)
        || emailMatches(resource.data.email)
        || emailMatches(resource.data.emailAddress)
        || emailMatches(resource.data.authorizedEmail)
        || emailMatches(resource.data.userEmail);
      allow create, update, delete: if isSuperadmin();
    }

    match /authorizedPersonnel/{docId} {
      allow read: if isAdminOrHigher()
        || emailMatches(docId)
        || emailMatches(resource.data.email)
        || emailMatches(resource.data.emailAddress)
        || emailMatches(resource.data.authorizedEmail)
        || emailMatches(resource.data.userEmail);
      allow create, update: if isSuperadmin()
        || (signedInRole() == 'admin' && isPersonnelRoleValue(requestedPersonnelRole()));
      allow delete: if isSuperadmin()
        || (signedInRole() == 'admin' && isPersonnelRoleValue(existingPersonnelRole()));
    }

    match /deleteArchived/{docId} {
      allow read: if isAdminOrHigher();
      allow create, update: if isAdminOrHigher();
      allow delete: if isSuperadmin();
    }

    match /serviceBookings/{docId} {
      allow read, create, update: if isStaffOrHigher();
      allow delete: if isAdminOrHigher();
    }

    match /inventory/{docId} {
      allow read: if true;
      allow create, update: if isStaffOrHigher();
      allow delete: if isAdminOrHigher();
    }

    match /masterData/inventory/categories/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrHigher();
    }

    match /masterData/inventory/models/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrHigher();
    }

    match /masterData/inventory/variants/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrHigher();
    }

    match /masterData/inventory/series/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrHigher();
    }

    match /technicians/{docId} {
      allow read, create, update: if isStaffOrHigher();
      allow delete: if isAdminOrHigher();
    }

    match /inventoryLogs/{docId} {
      allow read: if isStaffOrHigher();
      allow create, update: if isStaffOrHigher();
      allow delete: if isAdminOrHigher();
    }

    match /financingApplications/{docId} {
      allow read: if isAdminOrHigher()
        || (isSignedIn() && request.auth.uid == resource.data.applicant.uid)
        || (isSignedIn() && request.auth.uid == resource.data.submittedBy.uid)
        || emailMatches(resource.data.applicant.email)
        || emailMatches(resource.data.submittedBy.email);
      allow create: if isSignedIn();
      allow update: if isAdminOrHigher();
      allow delete: if isSuperadmin();

      match /messages/{messageId} {
        allow read: if isAdminOrHigher()
          || (isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/financingApplications/$(docId)).data.applicant.uid)
          || (isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/financingApplications/$(docId)).data.submittedBy.uid);
        allow create: if isSignedIn()
          && (request.auth.uid == get(/databases/$(database)/documents/financingApplications/$(docId)).data.applicant.uid
            || request.auth.uid == get(/databases/$(database)/documents/financingApplications/$(docId)).data.submittedBy.uid
            || isAdminOrHigher());
        allow update: if isAdminOrHigher();
      }
    }

    match /conversations/{docId} {
      allow read: if isAdminOrHigher() || resource.data.isGuest == true || emailMatches(resource.data.userEmail) || request.auth.uid == resource.data.userId;
      allow create: if true;
      allow update: if isAdminOrHigher() || request.auth.uid == resource.data.userId;
      
      match /messages/{messageId} {
        allow read: if isAdminOrHigher() || get(/databases/$(database)/documents/conversations/$(docId)).data.isGuest == true || request.auth.uid == get(/databases/$(database)/documents/conversations/$(docId)).data.userId;
        allow create: if true;
        allow update: if isAdminOrHigher();
      }
    }

    match /services/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrHigher();
    }

    match /users/{userId}/vehicles/{vehicleId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdminOrHigher());
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdminOrHigher());
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdminOrHigher());
    }
  }
}
